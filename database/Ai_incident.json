    {
      "parameters": {
        "jsCode": "const logs = $input.all();\n\nconst counters = {};\n\nfor (const item of logs) {\n\n  const ip = item.json.source_ip || \"\";\n  const msg = (item.json.log_message || \"\").toLowerCase();\n\n  let event = \"OTHER\";\n\n  if (msg.includes(\"failed login\")) {\n    event = \"FAILED_LOGIN\";\n  } else if (msg.includes(\"port scan\")) {\n    event = \"PORT_SCAN\";\n  }\n\n  if (!ip) continue;\n\n  const key = `${ip}_${event}`;\n\n  if (!counters[key]) {\n    counters[key] = {\n      source_ip: ip,\n      event_type: event,\n      attempts: 0,\n    };\n  }\n\n  counters[key].attempts++;\n}\n\nconst incidents = [];\n\nfor (const key in counters) {\n\n  const item = counters[key];\n\n  if (item.event_type === \"FAILED_LOGIN\" && item.attempts >= 5) {\n    incidents.push({\n      json: {\n        incident: true,\n        attack_type: \"Brute Force\",\n        source_ip: item.source_ip,\n        attempts: item.attempts,\n        severity: \"High\"\n      }\n    });\n  }\n\n  if (item.event_type === \"PORT_SCAN\" && item.attempts >= 3) {\n    incidents.push({\n      json: {\n        incident: true,\n        attack_type: \"Port Scan\",\n        source_ip: item.source_ip,\n        attempts: item.attempts,\n        severity: \"Medium\"\n      }\n    });\n  }\n\n}\n\nreturn incidents;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
